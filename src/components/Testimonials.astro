---
const testimonials = [
  {
    quote:
      '"Rocío entendió la idea que tenía en mente. Su atención a cada detalle y la calidad de la tela se hicieron notar en mi boda."',
    name: "Mariana Fernández",
    details: "Boda en Lima · Novia Rocío Leyva 2025",
  },
  {
    quote:
      '"Los años de experiencia de Rocío se notan. Recibí muchos cumplidos por mi vestido."',
    name: "Camila De la Fuente",
    details: "Boda en Cusco · Novia Rocío Leyva 2024",
  },
  {
    quote:
      '"El proceso de pruebas fue muy agradable. Ver cómo mi idea tomaba forma paso a paso fue una de las mejores partes de este proceso."',
    name: "Valeria & Santiago",
    details: "Boda de Destino · Novia Rocío Leyva 2025",
  },
];
---

<section id="testimonios" class="section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Lo que Dicen Nuestras Novias</h2>
      <div class="section-divider"></div>
    </div>

    <div class="testimonials-grid">
      {
        testimonials.map((item) => (
          <article class="testimonial-card">
            <div>
              <div class="testimonial-stars" aria-label="5 estrellas">
                {[1,2,3,4,5].map(() => (
                  <svg class="icon-inline gold-text" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1L12 2z"/></svg>
                ))}
              </div>
              <p class="testimonial-quote">{item.quote}</p>
            </div>
            <div class="testimonial-bride-info">
              <h4 class="bride-name">{item.name}</h4>
              <p class="bride-details">{item.details}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
