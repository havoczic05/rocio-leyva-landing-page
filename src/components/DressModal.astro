---
---

<div
  class="modal-backdrop"
  id="modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  aria-hidden="true"
  hidden
>
  <div class="modal-dialog" id="modal-dialog" tabindex="-1">
    <button class="modal-close-btn" id="modal-close-btn" aria-label="Cerrar detalles del vestido" type="button">
      <span aria-hidden="true">&times;</span>
    </button>
    <div class="modal-media">
      <img src="/assets/hero-banner-wedding-dress.avif" id="modal-img" alt="Vista detallada del vestido de novia" width="800" height="1100" decoding="async" />
    </div>
    <div class="modal-body">
      <div>
        <h3 class="section-title" id="modal-title" style="font-size: 1.75rem; text-align: left; margin-bottom: 0.75rem;">Nombre del Vestido</h3>
        <p style="color: var(--color-text-secondary); font-size: var(--text-sm);" id="modal-desc">
          Descripción detallada del diseño...
        </p>
      </div>
      <div style="margin-top: 2.0rem;">
        <a href="#contacto" id="modal-cta-btn" class="btn btn-primary" style="width: 100%;">
          Reservar Cita para Probar este Diseño
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  function initDressModal() {
    const modalBackdrop = document.getElementById('modal-backdrop');
    const modalDialog = document.getElementById('modal-dialog');
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const modalTitle = document.getElementById('modal-title');
    const modalImg = document.getElementById('modal-img') as HTMLImageElement | null;
    const modalDesc = document.getElementById('modal-desc');
    const modalCtaBtn = document.getElementById('modal-cta-btn');

    if (!modalBackdrop || !modalDialog) return;

    let lastFocused: HTMLElement | null = null;

    function getFocusable(): HTMLElement[] {
      const selector = 'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
      return Array.from(modalDialog.querySelectorAll<HTMLElement>(selector))
        .filter((el) => !el.hasAttribute('disabled') && el.offsetParent !== null);
    }

    function openModal(title: string, _category: string, imgSrc: string, description: string) {
      lastFocused = document.activeElement as HTMLElement | null;
      if (modalTitle) modalTitle.textContent = title;
      if (modalImg) {
        modalImg.src = imgSrc;
        modalImg.alt = title;
      }
      if (modalDesc) modalDesc.textContent = description;

      modalBackdrop!.hidden = false;
      modalBackdrop!.setAttribute('aria-hidden', 'false');
      // next frame so [hidden] removal applies before focus
      requestAnimationFrame(() => {
        modalBackdrop!.classList.add('active');
        document.body.style.overflow = 'hidden';
        const focusables = getFocusable();
        (focusables[0] ?? modalDialog).focus();
      });
    }

    function closeModal() {
      modalBackdrop!.classList.remove('active');
      modalBackdrop!.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      // Wait for transition before fully hiding from a11y tree
      setTimeout(() => { modalBackdrop!.hidden = true; }, 200);
      lastFocused?.focus();
    }

    document.querySelectorAll('[data-open-modal]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const title = target.getAttribute('data-title') || '';
        const category = target.getAttribute('data-category') || '';
        const img = target.getAttribute('data-img') || '';
        const desc = target.getAttribute('data-desc') || '';
        openModal(title, category, img, desc);
      });
    });

    modalCloseBtn?.addEventListener('click', closeModal);
    modalBackdrop.addEventListener('click', (e) => {
      if (e.target === modalBackdrop) closeModal();
    });
    modalCtaBtn?.addEventListener('click', closeModal);

    // Focus trap
    document.addEventListener('keydown', (e) => {
      if (modalBackdrop.hidden) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
        return;
      }
      if (e.key !== 'Tab') return;
      const focusables = getFocusable();
      if (focusables.length === 0) {
        e.preventDefault();
        modalDialog.focus();
        return;
      }
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      const active = document.activeElement as HTMLElement | null;
      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initDressModal);
</script>
