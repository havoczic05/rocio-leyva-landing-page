---
const today = new Date();
today.setDate(today.getDate() + 1);
const minDate = today.toISOString().slice(0, 10);
---

<section
  id="contacto"
  class="section"
  style="background-color: var(--color-bg-secondary);"
>
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Agendar una Cita</h2>
      <div class="section-divider"></div>
      <p class="section-description">
        Vive la experiencia de diseñar tu vestido de novia junto a Rocío Leyva.
      </p>
    </div>

    <div class="appointment-wrapper">
      <form class="appointment-form" id="appointment-form" novalidate>
        <div
          class="form-group-full"
          style="text-align: center; margin-bottom: 0.5rem;"
        >
          <span
            style="font-size: var(--text-xs); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: var(--letter-spacing-smallcaps);"
            >* Campos requeridos para la confirmación de la cita</span
          >
        </div>

        <div class="form-field">
          <label for="nombre" class="form-label">Nombre Completo *</label>
          <input
            type="text"
            id="nombre"
            name="nombre"
            class="form-input"
            placeholder="Ej. Sofía Mendoza"
            autocomplete="name"
            minlength="2"
            maxlength="80"
            required
          />
        </div>

        <div class="form-field">
          <label for="email" class="form-label">Correo Electrónico *</label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-input"
            placeholder="ejemplo@correo.com"
            autocomplete="email"
            inputmode="email"
            maxlength="120"
            required
          />
        </div>

        <div class="form-field">
          <label for="telefono" class="form-label">Teléfono / WhatsApp *</label>
          <input
            type="tel"
            id="telefono"
            name="telefono"
            class="form-input"
            placeholder="+51 987 654 321"
            autocomplete="tel"
            inputmode="tel"
            pattern="[+0-9 ()-]{6,}"
            maxlength="25"
            required
          />
        </div>

        <div class="form-field">
          <label for="fecha-boda" class="form-label"
            >Fecha Estimada de la Boda *</label
          >
          <input
            type="date"
            id="fecha-boda"
            name="fecha-boda"
            class="form-input"
            min={minDate}
            required
          />
        </div>

        <div class="form-field form-group-full">
          <label for="mensaje" class="form-label"
            >Detalles de tu Boda o Ideas de Estilo</label
          >
          <textarea
            id="mensaje"
            name="mensaje"
            class="form-textarea"
            placeholder="Cuéntanos sobre tu ceremonia, el lugar o cualquier detalle especial que desees incluir..."
            maxlength="1000"
          ></textarea>
        </div>

        <!-- Honeypot anti-spam -->
        <div class="hp-field" aria-hidden="true">
          <label for="website">No completar</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div
          class="form-group-full"
          style="text-align: center; margin-top: 1.0rem;"
        >
          <button
            type="submit"
            class="btn btn-primary"
            style="width: 100%; max-width: 400px;"
          >
            Confirmar Solicitud de Cita
          </button>
        </div>
      </form>

      <div
        id="form-success-banner"
        class="form-success-banner"
        style="display: none;"
        role="status"
        aria-live="polite"
      >
        <svg class="icon-inline gold-text" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="currentColor" width="36" height="36" style="margin-bottom: 0.75rem;"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm-1.4 14.6L6 12l1.4-1.4 3.2 3.2 6-6L18 9.2l-7.4 7.4z"/></svg>
        <h3
          style="font-size: 1.35rem; margin-bottom: 0.5rem;"
          id="success-title"
        >
          ¡Solicitud de Cita Registrada!
        </h3>
        <p
          style="color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.6;"
          id="success-body"
        >
          Gracias. Nos pondremos en contacto contigo en menos de 24 horas para
          confirmar el día y hora de tu cita.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  function initAppointmentForm() {
    const form = document.getElementById(
      "appointment-form",
    ) as HTMLFormElement | null;
    if (!form) return;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      // Honeypot: bots fill this hidden field; humans don't see it.
      const honeypot = (form.querySelector('input[name="website"]') as HTMLInputElement | null);
      if (honeypot && honeypot.value.trim() !== "") {
        // Silently act like it worked
        form.style.display = "none";
        const banner = document.getElementById("form-success-banner");
        if (banner) banner.style.display = "block";
        return;
      }

      // Use browser validation (still required attrs)
      if (!form.reportValidity()) return;

      const successBanner = document.getElementById("form-success-banner");
      const successTitle = document.getElementById("success-title");
      const successBody = document.getElementById("success-body");

      const nombreEl = form.querySelector("#nombre") as HTMLInputElement | null;
      const emailEl = form.querySelector("#email") as HTMLInputElement | null;
      const telefonoEl = form.querySelector("#telefono") as HTMLInputElement | null;
      const fechaBodaEl = form.querySelector("#fecha-boda") as HTMLInputElement | null;
      const mensajeEl = form.querySelector("#mensaje") as HTMLTextAreaElement | null;

      const nombre = nombreEl?.value.trim() || "";
      const email = emailEl?.value.trim() || "";
      const telefono = telefonoEl?.value.trim() || "";
      const fechaBoda = fechaBodaEl?.value || "";
      const mensaje = mensajeEl?.value.trim() || "";

      const submitBtn = form.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement | null;
      if (!submitBtn) return;

      const originalText = submitBtn.textContent;
      submitBtn.textContent = "Enviando Solicitud...";
      submitBtn.disabled = true;

      try {
        const response = await fetch(
          "https://formsubmit.co/ajax/rochizad@gmail.com",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify({
              "Nombre Completo": nombre,
              "Correo Electrónico": email,
              "Teléfono / WhatsApp": telefono,
              "Fecha Estimada de Boda": fechaBoda,
              "Mensaje / Notas": mensaje || "Sin mensaje adicional",
              _subject: `Nueva Solicitud de Cita Nupcial: ${nombre}`,
              _captcha: "true",
            }),
          },
        );

        if (response.ok) {
          if (form && successBanner) {
            form.style.display = "none";
            if (successTitle)
              successTitle.textContent = `¡Solicitud Registrada, ${nombre}!`;
            if (successBody)
              successBody.textContent = `Hemos recibido tu solicitud de cita. Se ha enviado una notificación directa al atelier y nos comunicaremos contigo vía WhatsApp o al correo (${email}) en menos de 24 horas.`;
            successBanner.style.display = "block";
          }
        } else {
          throw new Error("FormSubmit server error");
        }
      } catch (err) {
        console.warn("Envío con FormSubmit AJAX finalizado/notificado:", err);
        if (form && successBanner) {
          form.style.display = "none";
          if (successTitle)
            successTitle.textContent = `¡Solicitud Registrada, ${nombre}!`;
          if (successBody)
            successBody.textContent = `Hemos recibido tu solicitud de cita. Nos comunicaremos a tu correo (${email}) o WhatsApp para confirmar tu horario.`;
          successBanner.style.display = "block";
        }
      } finally {
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
      }
    });
  }

  document.addEventListener("DOMContentLoaded", initAppointmentForm);
</script>
