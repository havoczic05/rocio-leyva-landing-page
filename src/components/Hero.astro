---
---

<section id="hero" class="hero">
  <div class="hero-media-wrapper">
    <img
      src="/assets/hero-banner-wedding-dress.avif"
      alt="Vestido de novia de alta costura Rocío Leyva"
      class="hero-img"
      width="1920"
      height="1080"
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
    <div class="hero-overlay" aria-hidden="true"></div>
  </div>

  <div class="hero-content">
    <h1 class="hero-title">
      Alta Costura para bodas &amp; eventos sociales en Lima
    </h1>
    <p class="hero-subtitle">
      Diseñando vestidos de novia únicos y memorables con más de 25 años de
      maestría artesanal, telas de alta calidad y bordados a mano.
    </p>
    <div class="hero-actions">
      <a href="#contacto" class="btn btn-white">Agendar Cita</a>
      <a href="#coleccion" class="btn btn-outline btn-outline-on-dark">Explorar Colección</a>
    </div>
  </div>
</section>
