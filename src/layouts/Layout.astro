---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const siteUrl = 'https://rocioleyva.com';
const {
  title = 'Rocío Leyva — Alta Costura para bodas & eventos sociales en Lima',
  description = 'Diseñadora de modas Rocío Leyva. Más de 25 años de maestría artesanal en confección a medida para bodas, novias y eventos sociales en Lima, Perú.',
  ogImage = '/assets/og-rocio-leyva.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();

// JSON-LD: Atelier / LocalBusiness para SEO local
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteUrl}#business`,
  name: 'Rocío Leyva Alta Costura',
  alternateName: 'Atelier Rocío Leyva',
  description,
  url: siteUrl,
  telephone: '+51-991296334',
  email: 'rochizad@gmail.com',
  image: ogImageUrl,
  priceRange: '$$$$',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'La Molina',
    addressRegion: 'Lima',
    addressCountry: 'PE',
  },
  areaServed: [
    { '@type': 'City', name: 'Lima' },
    { '@type': 'Country', name: 'Perú' },
  ],
  knowsAbout: [
    'Alta Costura',
    'Vestidos de Novia',
    'Diseño a Medida',
    'Bordado a Mano',
    'Eventos Sociales',
  ],
  sameAs: [
    'https://www.instagram.com/rocio.leyva.atelier',
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '10:00',
      closes: '19:00',
    },
  ],
};
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#121212" />
  <meta name="color-scheme" content="light" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Favicons -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <link rel="manifest" href="/assets/site.webmanifest" />

  <!-- Preconnect & preload critical resources -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="image" href="/assets/hero-banner-wedding-dress.avif" type="image/avif" fetchpriority="high" />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Roboto:wght@300;400;500;700&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Roboto:wght@300;400;500;700&display=swap" media="print" onload="this.media='all'" />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Roboto:wght@300;400;500;700&display=swap" />
  </noscript>

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_PE" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Rocío Leyva Alta Costura" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Atelier Rocío Leyva — Alta Costura Nupcial en Lima" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content="Atelier Rocío Leyva — Alta Costura Nupcial en Lima" />

  <!-- JSON-LD: Atelier local business structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</head>
<body>
  <a class="skip-link" href="#main-content">Saltar al contenido principal</a>
  <slot />
</body>
</html>
